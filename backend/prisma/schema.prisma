// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/lib/generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum Role {
  CUSTOMER
  ADMIN
}

enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  CANCELLED
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String
  name         String
  address      String   @default("")
  role         Role     @default(CUSTOMER)
  createdAt    DateTime @default(now())

  cartItems CartItem[] @relation("UserCartItems")
  orders    Order[]    @relation("Orders")

  @@map("users")
}

model Category {
  id   Int    @id @default(autoincrement())
  name String
  slug String @unique

  products Product[] @relation("CategoryOfProduct")

  @@map("categories")
}

model Product {
  id          Int      @id @default(autoincrement())
  categoryId  Int
  name        String
  description String   @db.Text
  price       Int
  imageUrl    String
  stock       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  category   Category    @relation("CategoryOfProduct", fields: [categoryId], references: [id])
  cartItems  CartItem[]  @relation("ProductOfCartItem")
  orderItems OrderItem[] @relation("ProductOfOrderItem")

  @@map("products")
}

model CartItem {
  userId    Int
  productId Int
  quantity  Int @default(1)

  user    User    @relation("UserCartItems", fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation("ProductOfCartItem", fields: [productId], references: [id], onDelete: Cascade)

  @@id([userId, productId], name: "cart_item_pk")
  @@map("cartItems")
}

model Order {
  id              Int         @id @default(autoincrement())
  userId          Int
  status          OrderStatus @default(PENDING)
  totalAmount     Int
  shippingAddress String      @db.Text
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  user  User        @relation("Orders", fields: [userId], references: [id], onDelete: Cascade)
  items OrderItem[] @relation("OrderItems")

  @@map("orders")
}

model OrderItem {
  orderId   Int
  productId Int
  name      String
  price     Int
  quantity  Int

  product Product @relation("ProductOfOrderItem", fields: [productId], references: [id], onDelete: Cascade)
  order   Order   @relation("OrderItems", fields: [orderId], references: [id], onDelete: Cascade)

  @@id([orderId, productId], name: "order_item_pk")
  @@map("orderItems")
}
